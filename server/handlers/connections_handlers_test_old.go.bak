func TestUpdateConnectionById_InvalidJSON(t *testing.T) {
	h := newConnectionsTestHandler(t)

	req := httptest.NewRequest(
		http.MethodPut,
		"/connections/test",
		strings.NewReader("{bad-json}"),
	)

	req = mux.SetURLVars(req, map[string]string{
		"connectionId": uuid.Must(uuid.NewV4()).String(),
	})

	rr := httptest.NewRecorder()

	h.UpdateConnectionById(
		rr,
		req,
		nil,
		&models.User{
			ID: uuid.Must(uuid.NewV4()),
		},
		nil,
	)

	if rr.Code != http.StatusBadRequest {
		t.Fatalf("got %d want %d", rr.Code, http.StatusBadRequest)
	}
}
func TestHandleMeshSyncDeploymentModeChange_NilConnection(t *testing.T) {
	h := newConnectionsTestHandler(t)

	id := uuid.Must(uuid.NewV4())

	_, _, _, err := h.handleMeshSyncDeploymentModeChange(
		context.Background(),
		id,
		nil,
		"",
		id,
		nil,
	)

	if err == nil {
		t.Fatal("expected error")
	}
}
func TestHandleMeshSyncDeploymentModeChange_NilSystemID(t *testing.T) {
	h := newConnectionsTestHandler(t)
	h.SystemID = nil

	_, _, _, err := h.handleMeshSyncDeploymentModeChange(
		context.Background(),
		uuid.Must(uuid.NewV4()),
		&connections.ConnectionPayload{}, // nil nahi
		"",
		uuid.Must(uuid.NewV4()),
		nil,
	)

	if err == nil {
		t.Fatal("expected error")
	}
}
func TestDeleteConnection_NilProvider(t *testing.T) {
	h := newConnectionsTestHandler(t)

	req := httptest.NewRequest(http.MethodDelete, "/connections/test", nil)
	req = mux.SetURLVars(req, map[string]string{
		"connectionId": uuid.Must(uuid.NewV4()).String(),
	})

	rr := httptest.NewRecorder()

	defer func() {
		if recover() == nil {
			t.Fatal("expected panic from nil provider")
		}
	}()

	var provider models.Provider

	h.DeleteConnection(
		rr,
		req,
		nil,
		&models.User{ID: uuid.Must(uuid.NewV4())},
		provider,
	)
}
