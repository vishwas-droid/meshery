	rr := httptest.NewRecorder()

	h.GetConnections(
		rr,
		req,
		nil,
		&models.User{ID: uuid.Must(uuid.NewV4())},
		nil,
	)

	if rr.Code != http.StatusInternalServerError {
		t.Fatalf("expected %d got %d", http.StatusInternalServerError, rr.Code)
	}
}

