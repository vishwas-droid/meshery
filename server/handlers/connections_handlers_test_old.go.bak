	rr := httptest.NewRecorder()

	payload := &connections.ConnectionPayload{
		Kind: "kubernetes",
	}

	defer func() {
		if recover() == nil {
			t.Fatal("expected panic")
		}
	}()

	h.handleRegistrationInitEvent(rr, req, payload)
}
