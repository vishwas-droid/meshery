package handlers

import (
	"net/http"
	"net/http/httptest"
	"strings"
	"testing"

	"context"
	"github.com/gofrs/uuid"
	"github.com/gorilla/mux"
	"github.com/meshery/meshery/server/models"
	"github.com/meshery/meshery/server/models/connections"
	"github.com/meshery/meshkit/logger"
	"github.com/meshery/schemas/models/core"
)

func newConnectionsTestHandler(t *testing.T) *Handler {
	log, err := logger.New("test", logger.Options{})
	if err != nil {
		t.Fatalf("failed to create logger: %v", err)
	}

	id := core.Uuid(uuid.Must(uuid.NewV4()))

	return &Handler{
		log:      log,
		SystemID: &id,
	}
}

func TestHandleProcessTermination_BadJSON(t *testing.T) {
	h := newConnectionsTestHandler(t)

	req := httptest.NewRequest(
		http.MethodDelete,
		"/",
		strings.NewReader("{bad json"),
	)

	rr := httptest.NewRecorder()

	h.handleProcessTermination(rr, req)

	if rr.Code != http.StatusBadRequest {
		t.Fatalf("expected %d got %d", http.StatusBadRequest, rr.Code)
	}
}
func TestGetConnectionByID_InvalidUUID(t *testing.T) {
	h := newConnectionsTestHandler(t)

	req := httptest.NewRequest(
		http.MethodGet,
		"/connections/invalid",
		nil,
	)

	req = mux.SetURLVars(req, map[string]string{
		"connectionId": "invalid-uuid",
	})

	rr := httptest.NewRecorder()

	h.GetConnectionByID(
		rr,
		req,
		nil,
		nil,
		nil,
	)

	if rr.Code != http.StatusBadRequest {
		t.Fatalf("expected %d got %d", http.StatusBadRequest, rr.Code)
	}
}
func TestGetConnections_InvalidStatusJSON(t *testing.T) {
